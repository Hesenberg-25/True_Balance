# Copy this file to Backend/.env and fill in real values. Do NOT commit the real .env to Git.

# Use a managed Postgres or your DB provider's connection string
# Example (Postgres):
DATABASE_URL=postgresql://<db_user>:<db_password>@<host>:5432/<database>

# Frontend URL used for CORS / callbacks (set to your deployed frontend)
FRONTEND_URL=http://localhost:3000

# Public Render backend URL used by the deployed Vercel frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Secret used to sign session cookies. Use a long, random value in production.
SESSION_SECRET=change-me-to-a-strong-random-string

# Resend email delivery. Use a verified sender/domain in production.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=TrueBalance <no-reply@your-verified-domain.example>
